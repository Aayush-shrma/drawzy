{
  "name": "drawzy",
  "productName": "Drawzy",
  "desktopName": "drawzy.desktop",
  "version": "1.2.0",
  "description": "Draw on anything on your screen. Excalidraw-style sketching, arrows, notes and a laser pointer, one shortcut away. For Windows, macOS and Linux.",
  "main": "src/main.js",
  "author": "Aayush Sharma",
  "license": "MIT",
  "homepage": "https://github.com/Aayush-shrma/drawzy#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aayush-shrma/drawzy.git"
  },
  "bugs": {
    "url": "https://github.com/Aayush-shrma/drawzy/issues"
  },
  "keywords": [
    "screen-annotation",
    "drawing",
    "overlay",
    "excalidraw",
    "whiteboard",
    "presentation",
    "electron",
    "windows",
    "macos",
    "linux"
  ],
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "test": "electron . --self-test",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.3",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aayushsharma.drawzy",
    "productName": "Drawzy",
    "copyright": "Copyright © 2026 Aayush Sharma",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Drawzy",
      "artifactName": "Drawzy-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Drawzy-Portable.exe"
    },
    "mac": {
      "icon": "src/assets/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "Drawzy-mac.dmg"
    },
    "dmg": {
      "title": "Drawzy",
      "artifactName": "Drawzy-mac.dmg"
    },
    "linux": {
      "icon": "src/assets/icon.png",
      "category": "Graphics",
      "synopsis": "Draw on anything on your screen",
      "maintainer": "Aayush Sharma <aayushsharma9851@gmail.com>",
      "vendor": "Aayush Sharma",
      "executableName": "drawzy",
      "executableArgs": [
        "--ozone-platform=x11"
      ],
      "desktop": {
        "entry": {
          "Keywords": "draw;annotate;whiteboard;excalidraw;screen;presentation;"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Drawzy-linux.AppImage"
    },
    "deb": {
      "artifactName": "Drawzy-linux.deb"
    },
    "rpm": {
      "artifactName": "Drawzy-linux.rpm"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
